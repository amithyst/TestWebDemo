[
  {
    "id": "django-deploy",
    "execute-command": "/home/dkj/deploy_scripts/deploy.sh",
    "command-working-directory": "/home/dkj/deploy_scripts/",
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hash-sha256",
            "secret": "0"
          }
        },
        {
          "type": "value",
          "extract": "ref",
          "match": {
            "type": "string",
            "value": "refs/heads/main"
          }
        }
      ]
    },
    "response-message": "Deployment webhook received and script triggered."
  }
]